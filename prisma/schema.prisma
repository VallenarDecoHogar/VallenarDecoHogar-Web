// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Usuario — registro y login
// ============================================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cartItems    CartItem[]
  wishlistItems WishlistItem[]
  newsletter   Newsletter?
}

// ============================================================
// Carrito persistente por usuario
// ============================================================
model CartItem {
  id           String   @id @default(cuid())
  userId       String
  productId    String   // ID del producto en products.ts (p1, p2, ...)
  variantIndex Int      @default(0)  // Índice de la variante seleccionada
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantIndex])
}

// ============================================================
// Lista de deseos persistente por usuario
// ============================================================
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ============================================================
// Suscripción al newsletter (para enviar ofertas)
// ============================================================
model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  userId    String?  @unique  // Si se registró, vincular al usuario
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
